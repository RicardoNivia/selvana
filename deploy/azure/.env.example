# Plantilla de deploy/azure/.env.pruebas (git lo ignora). desplegar.ps1 lo copia a la VM como /opt/selvana/.env.
DOMINIO=selvana-pruebas.northcentralus.cloudapp.azure.com
REGISTRO=<registro>.azurecr.io
# Token del registro solo para descargar imágenes (az acr token create ... --scope-map _repositories_pull)
REGISTRO_USUARIO=
REGISTRO_CLAVE=
CADENA_BD=Host=<servidor>.postgres.database.azure.com;Port=5432;Database=selvana;Username=selvana;Password=<contraseña>;SslMode=Require
MENSAJERIA_CLAVE=
# Contraseña de los usuarios ficticios (Servicios Andinos y las empresas de ejemplo)
CONTRASENA_PRUEBAS=
# Usuario administrador del dueño del ambiente en «Talento Andino EST» (mínimo 10 caracteres con letras y números)
EJEMPLO_CORREO=
EJEMPLO_NOMBRE=
EJEMPLO_CONTRASENA=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
