# Un solo dominio para la web y la API: la cookie de sesión (SameSite=Strict) funciona sin CORS.
# Caddy saca y renueva el certificado HTTPS solo. /internal, /swagger y /openapi no se publican.
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
