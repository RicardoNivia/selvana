# Copie este archivo como .env (git lo ignora) y complete los valores.

# --- docker-compose ---
POSTGRES_DB=selvana
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Clave compartida entre la API y el AI.Worker (ADR 0008)
MENSAJERIA_CLAVE=
API_PORT=5000
WEB_PORT=5173
# Emisor OpenID Connect (Entra ID, Google, identidad propia...); vacío en desarrollo
AUTH_AUTHORITY=

# --- Azure DevOps (scripts/crear-backlog-azure.ps1 y agente azure-backlog) ---
AZURE_DEVOPS_PAT=

# --- IA (gateway de modelos: Gemini gratis -> Gemini pago -> Anthropic) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- PostgreSQL local (API, worker y dotnet ef fuera de Docker; lo lee scripts/levantar-local.ps1) ---
SELVANA_PG_HOME=
PGHOST=localhost
PGPORT=5432
PGDATABASE=selvana
PGUSER=postgres
PGPASSWORD=
ConnectionStrings__Selvana=Host=localhost;Port=5432;Database=selvana;Username=postgres;Password=
